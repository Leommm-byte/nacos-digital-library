# ------------------------------------------------------------------
# NACOS YabaTech — environment configuration
# Copy to .env. Never commit .env. Production values live only on the server.
# ------------------------------------------------------------------
APP_NAME="NACOS YabaTech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_DISPLAY_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose overrides DB_HOST to "db" automatically.
# Without Docker, point these at your local MySQL 8.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nacos
DB_USERNAME=nacos
DB_PASSWORD=secret

# Database-backed drivers: no Redis needed, works on shared hosting.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Local mail goes to Mailpit (http://localhost:8025) when using Docker.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nacosyabatech.com"
MAIL_FROM_NAME="${APP_NAME}"
# Account invitations sent per hour (DreamHost allows about 100 emails an hour).
MAIL_INVITATIONS_PER_HOUR=80

VITE_APP_NAME="${APP_NAME}"

# Optional: an Anthropic API key improves the text of scanned uploads with AI
# (queued; runs from the cron) and turns on AI answers in the assistant.
# Without it, scans keep the text read on the uploader's device and the
# assistant gives free keyword answers.
ANTHROPIC_API_KEY=
# AI answers per student per day (also editable in admin settings; 0 = off).
ASSISTANT_DAILY_LIMIT=30

# ------------------------------------------------------------------
# Running the live site (docs/deployment.md). Leave empty locally.
# ------------------------------------------------------------------
# Errors, failed backups and low disk space are emailed here (production only).
ALERT_EMAIL=
# Off-site backups: "backups" turns them on, with an S3-compatible bucket
# (Backblaze B2: endpoint and region from the bucket's page).
BACKUP_DISK=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
# A daily warning email when uploads, backups and the database pass this size.
DISK_WARN_GB=20
