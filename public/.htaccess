<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# PDF.js ships its worker as .mjs, which some servers don't know is
# JavaScript (module workers refuse anything else).
<IfModule mod_mime.c>
    AddType text/javascript .mjs
    AddType application/wasm .wasm
    AddType application/manifest+json .webmanifest
</IfModule>

# Built assets have content hashes in their names, so they never change:
# cache them for a year. Everything else (images, favicon, the PDF.js and
# Tesseract files under /build/pdfjs and /build/tesseract) for a week.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/build/assets/#"
    </FilesMatch>
    <FilesMatch "\.(ico|png|webp|svg|bcmap|pfb|ttf|wasm|icc|gz)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=604800" "expr=%{REQUEST_URI} =~ m#^/build/(pdfjs|tesseract)/#"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
